{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd web && npm ci",
  "buildCommand": "cd web && VITE_STATIC_SITE=1 npm run build",
  "outputDirectory": "web/dist",
  "redirects": [
    {
      "source": "/team",
      "destination": "/our-members",
      "permanent": true
    },
    {
      "source": "/apply",
      "destination": "/membership-apply",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
