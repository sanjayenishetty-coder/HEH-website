NODE_ENV=production
PORT=1502
HOST=127.0.0.1

# PostgreSQL connection
DATABASE_URL=postgres://heh:CHANGE_ME@127.0.0.1:5432/heh_test

# First admin account (generate the hash with: npm run hash-password -- 'your-password').
# Copied into the admin_users table when the API starts and the table is empty; after that the password
# lives in the database (changed with "Forgot Password?"), so editing these later has no effect.
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=
# Email of the first admin: password reset links, sign-in codes and Google sign-in use it
ADMIN_EMAIL=
# 1 = email a 6-digit security code at every password sign-in (needs SMTP below)
ADMIN_LOGIN_CODE=0

# Outgoing email for the admin sign-in screens; leave SMTP_HOST empty to turn email features off
SMTP_HOST=
SMTP_PORT=587
# 1 for port 465; port 587 uses STARTTLS
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM="HEH Portal <heh@entrepreneurhub.in>"
# Public address used in emailed links
SITE_URL=https://heh.visuprojects.in

# Google sign-in: OAuth client ID (Web application) from Google Cloud console, with this site's address as an
# authorised JavaScript origin. The button is hidden until this is set; only ADMIN emails can sign in.
GOOGLE_CLIENT_ID=
# Long random string used to sign admin session cookies
SESSION_SECRET=

# Where uploaded images are stored; nginx serves this folder at /uploads/
UPLOAD_DIR=/srv/heh/prod/uploads
# Member Portal verification documents (private; never served by nginx). Default: <UPLOAD_DIR>-documents
# DOC_DIR=/srv/heh/prod/uploads-documents

# Local only: also serve the built site (../web/dist) and UPLOAD_DIR from this process (or use `npm run dev` in web/)
SERVE_STATIC=0
